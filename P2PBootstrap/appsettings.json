{
  "Configuration": {
    "KeysDirectory": "keys",
    "BootstrapMode": "authority",
    "AuthorityKey": {
      "PrivateKey": "private.asc",
      "PublicKey": "public.asc"
    },
    "NetworkName": "P2P Mainnet",
    "OptionalEndpoints": {
      "PublicIP": "true",
    },
    "OptionalServices": {
      "WebRTC": "false",
      "UDPNATHolepunch": "false",
      "TURN": "true"
    },
    "Identifier":  "staticbootstrap11"
  },
  "Database": {
    "DbFilename": "local_database",
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
} 
