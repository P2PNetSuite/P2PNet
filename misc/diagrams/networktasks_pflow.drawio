        <mxCell id="lv03y9vsbfHR4nwqhgse-51" value="&lt;div&gt;Determine if NetworkTask&amp;nbsp;&lt;/div&gt;&lt;div&gt;needs to be wrapped in&amp;nbsp;&lt;/div&gt;&lt;div&gt;DataTransmissionPacket or not&lt;/div&gt;&lt;div&gt;by checking type of connection&lt;/div&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;points=[];whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="lv03y9vsbfHR4nwqhgse-50">
