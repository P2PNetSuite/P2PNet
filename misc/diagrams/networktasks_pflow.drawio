        <mxCell id="lv03y9vsbfHR4nwqhgse-47" value="&lt;div&gt;If checks apply, utilize metadata&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp; provided by NetworkTaskOriginInfo&lt;/div&gt;&lt;div&gt;to ensure NetworkTask complies&lt;/div&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;points=[];whiteSpace=wrap;html=1;" vertex="1" parent="lv03y9vsbfHR4nwqhgse-45">
