        <mxCell id="lv03y9vsbfHR4nwqhgse-46" value="&lt;div&gt;Check static instance of NetworkTaskTrustSettings &lt;br&gt;&lt;/div&gt;&lt;div&gt;in TrustPolicies to determine&lt;/div&gt;&lt;div&gt;what TaskTrustParameter(s) apply&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;points=[];whiteSpace=wrap;html=1;verticalAlign=top;" vertex="1" parent="lv03y9vsbfHR4nwqhgse-45">
