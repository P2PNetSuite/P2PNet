        <mxCell id="lv03y9vsbfHR4nwqhgse-48" value="&lt;div&gt;&amp;nbsp; If checks are satisfied, NetworkTask moves to&lt;/div&gt;&lt;div&gt;its corresponding delegate&lt;/div&gt;&lt;div&gt;to be invoked&lt;/div&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;points=[];whiteSpace=wrap;html=1;" vertex="1" parent="lv03y9vsbfHR4nwqhgse-45">
